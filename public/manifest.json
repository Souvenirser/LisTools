{
  "manifest_version": 3,
  "name": "LisTools - 开发者工具箱",
  "short_name": "LisTools",
  "version": "1.0.0",
  "description": "本地 JSON 解析、美化与双栏差异对比，支持大 JSON、差异统计和跳转、展开折叠及无损数字。",
  "minimum_chrome_version": "120",
  "action": { "default_title": "打开 LisTools" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'none'"
  }
}
